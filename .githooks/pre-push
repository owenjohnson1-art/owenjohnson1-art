#!/usr/bin/env bash
# Blocks a push if any tracked file contains something that shouldn't be public:
# internal addresses, MACs, email addresses, local paths or secret-looking strings.
# Private words (network names, hostnames, usernames) come from a list kept outside
# the repo, so the list itself is never published.
set -u
cd "$(git rev-parse --show-toplevel)"
DENYLIST="${PORTFOLIO_DENYLIST:-$HOME/.homelab/portfolio-denylist.txt}"

patterns=(
  '\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b'
  '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
  '[A-Za-z]:\\Users\\'
  '/home/[a-z]'
  'BEGIN [A-Z ]*PRIVATE KEY'
  '\b(ghp|gho|github_pat)_[A-Za-z0-9_]{20,}'
  '\bsk-[A-Za-z0-9_-]{20,}'
  '\bAKIA[0-9A-Z]{16}\b'
  '(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*[^[:space:]]{6,}'
)

found=0
for p in "${patterns[@]}"; do
  if hits=$(git grep -nIiE "$p" -- . ':!.githooks' 2>/dev/null); then
    echo "Blocked pattern: $p"; echo "$hits"; found=1
  fi
done

if [ -f "$DENYLIST" ]; then
  while IFS= read -r word || [ -n "$word" ]; do
    word=$(printf '%s' "$word" | tr -d '\r')
    [ -z "$word" ] || [ "${word#\#}" != "$word" ] && continue
    if hits=$(git grep -nIiF "$word" -- . ':!.githooks' 2>/dev/null); then
      echo "Blocked private word from denylist"; echo "$hits"; found=1
    fi
  done < "$DENYLIST"
else
  echo "Warning: no denylist at $DENYLIST, only generic checks ran"
fi

if [ "$found" -ne 0 ]; then
  echo "Push blocked: remove the items above, commit, and push again."
  exit 1
fi
echo "Public-safety check passed."
